[Unit]
Description=CDT-switcher - Aliyun multi-account spot ECS rotator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 服务部署于独立控制机，使用专用本地用户。
User=cdt-switcher
Group=cdt-switcher
UMask=0077
WorkingDirectory=/opt/cdt-switcher
ExecStart=/opt/cdt-switcher/.venv/bin/python /opt/cdt-switcher/cdt_switcher.py /opt/cdt-switcher/config.yaml
Environment=TZ=Asia/Shanghai
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
LogRateLimitIntervalSec=60s
LogRateLimitBurst=300
# 进程异常退出后由 systemd 重启，启动频率受系统服务管理策略约束。

[Install]
WantedBy=multi-user.target
